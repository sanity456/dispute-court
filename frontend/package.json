{
  "name": "dispute-court-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "dev:vercel": "node scripts/next.mjs dev",
    "build:vercel": "node scripts/next.mjs build",
    "start:vercel": "node scripts/next.mjs start",
    "test": "node --test tests/*.test.mjs",
    "start": "vinext start",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib server db tests scripts vite.config.ts drizzle.config.ts eslint.config.mjs",
    "format:check": "prettier --check app components lib server db tests scripts vite.config.ts drizzle.config.ts eslint.config.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.19"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "drizzle-kit": "0.31.10",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
